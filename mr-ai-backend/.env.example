# =============================================================================
# mr-ai-backend — environment configuration
# Copy to `.env` and fill in real values. The Universal LLM Gateway loads this.
# =============================================================================

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# EnvFilter expression. Examples: "info", "debug", "info,reqwest=warn"
LOG_LEVEL=info
# Directory for rotated JSON logs (created if missing).
LOG_DIR=logs
# Prefix for the rotated file name (e.g. logs/mr-ai.2026-01-15)
LOG_FILE_PREFIX=mr-ai

# -----------------------------------------------------------------------------
# Usage history (persistent JSONL with one record per gateway call)
# -----------------------------------------------------------------------------
# Path to the append-only JSONL audit log (parent dir is created if missing).
USAGE_LOG_PATH=logs/usage.jsonl
# Set to true to disable persistence (in-memory counters still work).
USAGE_LOG_DISABLED=false
# Set to true to additionally store truncated prompt/response previews.
# Note: previews may contain proprietary source code — only enable in trusted
# environments. The JSONL file is created with mode 0600 on Unix.
USAGE_LOG_INCLUDE_PROMPTS=false
# Default ON. Replaces high-confidence secret patterns (sk-..., AKIA...,
# glpat-..., ghp_..., JWTs, Bearer headers, PEM private-key markers) with
# [REDACTED:KIND] before previews land on disk. Only set to false for
# short-lived debugging in trusted environments.
USAGE_LOG_REDACT_SECRETS=true
# Preview truncation length in Unicode characters.
USAGE_LOG_PREVIEW_CHARS=200

# -----------------------------------------------------------------------------
# LLM Gateway — pricing
# -----------------------------------------------------------------------------
# Path to the per-model pricing TOML, used for cost analytics.
LLM_PRICING_PATH=pricing.toml

# Health probe timeout (seconds).
LLM_HEALTH_TIMEOUT_SECS=10

# -----------------------------------------------------------------------------
# Fast tier — parsing, routing, draft completions.
# -----------------------------------------------------------------------------
LLM_FAST_PROVIDER=ollama
LLM_FAST_MODEL=llama3
# Optional explicit endpoint. Falls back to OLLAMA_URL / OPENAI_BASE_URL.
# LLM_FAST_ENDPOINT=http://localhost:11434
# LLM_FAST_API_KEY=
LLM_FAST_MAX_TOKENS=2048
LLM_FAST_TEMPERATURE=0.7
LLM_FAST_TOP_P=0.9
LLM_FAST_TIMEOUT_SECS=600

# -----------------------------------------------------------------------------
# Smart tier — deep reasoning, cross-microservice analysis.
# -----------------------------------------------------------------------------
LLM_SMART_PROVIDER=ollama
LLM_SMART_MODEL=llama3
# LLM_SMART_ENDPOINT=
# LLM_SMART_API_KEY=
LLM_SMART_MAX_TOKENS=4096
LLM_SMART_TEMPERATURE=0.2
LLM_SMART_TIMEOUT_SECS=900

# -----------------------------------------------------------------------------
# Embedding tier — vectorisation for RAG.
# -----------------------------------------------------------------------------
LLM_EMBED_PROVIDER=ollama
LLM_EMBED_MODEL=bge-m3
# LLM_EMBED_ENDPOINT=
# LLM_EMBED_API_KEY=
LLM_EMBED_TIMEOUT_SECS=60

# -----------------------------------------------------------------------------
# Provider-shared fallbacks (used when LLM_<TIER>_ENDPOINT is unset).
# -----------------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_API_KEY=sk-...

# AWS Bedrock fallbacks (used when LLM_<TIER>_PROVIDER=bedrock).
# Endpoint defaults to https://bedrock-runtime.<region>.amazonaws.com.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=

# -----------------------------------------------------------------------------
# Example — using AWS Bedrock for the smart tier (Claude 3.5 Sonnet) and
# embeddings (Titan v2). Toggle by changing the tier blocks above.
# -----------------------------------------------------------------------------
# LLM_SMART_PROVIDER=bedrock
# LLM_SMART_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
# LLM_SMART_REGION=us-east-1
# LLM_SMART_API_KEY=AKIA...
# LLM_SMART_SECRET_KEY=...
# LLM_SMART_MAX_TOKENS=4096
# LLM_SMART_TEMPERATURE=0.2

# LLM_EMBED_PROVIDER=bedrock
# LLM_EMBED_MODEL=amazon.titan-embed-text-v2:0
# LLM_EMBED_REGION=us-east-1
# LLM_EMBED_API_KEY=AKIA...
# LLM_EMBED_SECRET_KEY=...

# -----------------------------------------------------------------------------
# RAG / Qdrant
# -----------------------------------------------------------------------------
QDRANT_URL=http://localhost:6334
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=mr_ai_code
QDRANT_DISTANCE=Cosine
QDRANT_BATCH_SIZE=256
# Must match the dimensionality of the gateway's embedding model.
EMBEDDING_DIM=1024
RAG_DISABLE=false
RAG_TOP_K=30
RAG_TAKE_PER_TARGET=3
RAG_MIN_SCORE=0.35
CHUNK_MAX_CHARS=4000
CHUNK_MIN_CHARS=16

# Hybrid retrieval pipeline (S4). RAG_TOP_K above feeds the legacy contextor;
# the new RetrievalConfig honours these knobs alongside it.
RAG_MAX_HOPS=1
RAG_TOKEN_BUDGET=8000

# Review pipeline opt-ins (S9). Default off so dev workers never publish by
# accident. Flip both to `true` for end-to-end review with rerank diagnostics.
RAG_LLM_RERANK_ENABLED=false
RAG_RERANK_TIMEOUT_SECS=20
REVIEW_PUBLISH_COMMENTS=false

# -----------------------------------------------------------------------------
# Postgres (system-of-record for projects, MR state, jobs, graph, webhook events)
# -----------------------------------------------------------------------------
# Used by the Rust app via sqlx. The `postgres` service in docker-compose reads
# POSTGRES_* and the app reads DATABASE_URL.
POSTGRES_DB=mr_ai
POSTGRES_USER=mr_ai
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgres://mr_ai:change-me@localhost:5432/mr_ai

# Optional admin: `docker compose --profile dev up -d pgadmin` exposes a UI on
# http://localhost:${PGADMIN_PORT}.
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@local
PGADMIN_PASSWORD=admin

# When set to true, the app uses the bundled compile-time query metadata
# (sqlx-data.json) and does NOT need DATABASE_URL during `cargo build`.
# Set to true in CI; leave unset locally so live queries can be type-checked.
SQLX_OFFLINE=false

# If true (default) the app boots even if DATABASE_URL is unset or unreachable.
# Persistence-backed features then run in degraded mode. Set to false in prod.
DATABASE_OPTIONAL=true

# Maximum size of the sqlx connection pool.
DATABASE_MAX_CONNECTIONS=8

# -----------------------------------------------------------------------------
# Project group config (declarative source of truth for repos & dependencies)
# -----------------------------------------------------------------------------
# File path resolved relative to the working directory. The API fails to
# boot if the file is missing or unparseable. May declare one or more
# `[[project]]` groups — the multi-tenant lift (🅲) removed the
# single-project invariant. See `projects.toml.example` for the schema
# and `docs/services/multi-repo-review.md` for the cross-repo flow.
PROJECTS_CONFIG=projects.toml

# -----------------------------------------------------------------------------
# Secrets (resolved through SecretProvider — env or mounted file directory)
# -----------------------------------------------------------------------------
# Backend selector: `env` (default) or `file`.
SECRET_PROVIDER=env
# Root directory for the file backend. Layout: <SECRETS_DIR>/<project_slug>/<key>
# Each file is a single line (or whole content treated as the value, trailing
# newlines trimmed). Mode 0600 recommended.
SECRETS_DIR=/var/secrets

# -----------------------------------------------------------------------------
# Webhooks — per-provider HMAC secrets (M1, breaking change)
# -----------------------------------------------------------------------------
# As of sprint M1 of cross-repo MR review the legacy global
# `WEBHOOK_HMAC_SECRET` is GONE. Each provider has its own secret so two
# providers can coexist on the same instance without sharing keys.
# Resolved through SecretProvider — under the file backend the layout is
# `<SECRETS_DIR>/_global/webhook_hmac_<provider>`.
#
# Only set the variables for providers you actually receive webhooks from;
# the others stay unset and return `503 WEBHOOK_SECRET_UNSET` to any
# spoofed request.
#
# GitLab: plain-text comparison against `X-Gitlab-Token` header.
GITLAB_WEBHOOK_SECRET=change-me-gitlab-webhook
# GitHub: HMAC-SHA256 of the body, header `X-Hub-Signature-256`.
GITHUB_WEBHOOK_SECRET=change-me-github-webhook
# Bitbucket Server: HMAC-SHA256, header `X-Hub-Signature`.
# Bitbucket Cloud has no native HMAC — front it with a reverse proxy
# that injects the same header. See docs/guides/webhooks.md.
BITBUCKET_WEBHOOK_SECRET=change-me-bitbucket-webhook

# -----------------------------------------------------------------------------
# Background worker pool (S2)
# -----------------------------------------------------------------------------
WORKER_POOL_SIZE=4
WORKER_POLL_INTERVAL_MS=500

# -----------------------------------------------------------------------------
# Git service storage (S2 — bare clones + per-MR worktrees)
# -----------------------------------------------------------------------------
GIT_CACHE_DIR=code_data/git_cache
WORKTREE_DIR=code_data/worktrees

# -----------------------------------------------------------------------------
# HTTP API server
# -----------------------------------------------------------------------------
# Project identity (`project_slug` + UUID) is sourced from projects.toml at
# boot, not from env. See PROJECTS_CONFIG above and the single-project
# invariant in docs/guides/configuration.md.
API_ADDRESS=0.0.0.0:8080
GIT_API_BASE=https://gitlab.example.com/api/v4
GIT_TOKEN=glpat-...
# Doubles as the X-Admin-Token gate for every operator route
# (/admin/*, /retrieve, /search_vector_base, /trigger_git_mr).
# Comparison is constant-time. Rotate by restarting the API.
TRIGGER_SECRET=change-me

# Per-host credential overrides (S6 + M1) — append the host slug
# (uppercase with `.` and `-` replaced by `_`) to any of the credential
# keys to direct that host to a different value. Falls back to the
# unscoped key when no host-specific value is configured.
#
# Tokens (S6):
#   GIT_TOKEN_GITLAB_COM=glpat-gitlabcom
#   GIT_TOKEN_GITHUB_EXAMPLE_COM=ghp_selfhosted
#   SSH_KEY_PATH_GITLAB_COM=/var/secrets/keys/gitlab_com
#   GIT_HTTP_TOKEN_GIT_SELF_HOSTED_IO=...
#
# API base URL (M1) — only needed for self-hosted instances; public
# clouds resolve to provider-default URLs automatically:
#   GIT_API_BASE_GITLAB_ACME_IO=https://gitlab.acme.io/api/v4
#   GIT_API_BASE_GITHUB_ACME_IO=https://github.acme.io/api/v3
#
# See docs/guides/configuration.md#per-host-overrides-s6 for the slug
# rules and docs/guides/secrets.md for the file-mount layout
# (<SECRETS_DIR>/_hosts/<host>/<key>).
